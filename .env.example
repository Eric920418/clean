# ============================================
# invisible care · 環境變數範本
# 複製成 .env 後填入實際值（.env 會被 .gitignore 忽略）
# ============================================

# --- Database (Neon PostgreSQL，必須與 drink 專案使用「不同」的 DB) ---
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- NextAuth ---
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- 預設管理員（首次啟動會自動建立並 bcrypt hash） ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# --- Cloudflare R2（必須與 drink 專案使用「不同」的 bucket） ---
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="invisible-care"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"

# --- 站台公開設定（SEO / OG / sitemap 用） ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="invisible care"
